+                    Self::say(
+                        game,
+                        format!("Attack radius: {x:.1} blocks (server reach still applies)."),
+                    );
+                } else {
+                    Self::say(
+                        game,
+                        "Attack radius must be 1.0 to 6.0; actual reach still applies.",
+                    );
+                }
+            }
+            [_, _, _, "delay", value] => {
+                if let Some(x) = number(value, 0.1, 5.0) {
