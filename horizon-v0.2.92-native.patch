+                        ),
+                    );
+                }
+            }
+            [_, _, _, mode @ ("aim" | "bow" | "mine"), value] => {
+                if let Some(on) = switch(value) {
+                    self.disable_active(game, event_loop);
+                    match *mode {
+                        "aim" => self.aim = on,
+                        "bow" => self.bow = on,
+                        "mine" => {
+                            self.mine = on;
+                            if on {
