new file mode 100644
index 0000000..0827299
--- /dev/null
+++ b/crates/horizon-client/src/game/impact_native_nav.rs
@@ -0,0 +1,253 @@
+//! Bounded, conservative block-edit path planner. It plans a single local
+//! action at a time and rechecks the real, loaded world after each action.
+//! This is not Baritone; the executor may stop when a face is not reachable.
+use std::{
+    cmp::Reverse,
+    collections::{BinaryHeap, HashMap},
+};
+
+pub(super) type Node = [i32; 3];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Cell {
+    Empty,
+    Solid { breakable: bool },
+    Blocked,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Step {
+    Walk(Node),
+    Break(Node),
+    Place(Node, bool),
+}
+
+/// Try a cardinal neighbour at equal height, one above, or one below.
+/// At most two full scaffold blocks support a step up. A descent must land on
+/// an existing full block: no digging straight under the player's feet.
+fn transition<F, S>(
+    from: Node,
+    to: Node,
+    can_place: bool,
+    cell: &F,
+    safe: &S,
+) -> Option<(Step, u32)>
+where
+    F: Fn(Node) -> Cell,
+    S: Fn(Node) -> bool,
+{
+    let dy = to[1] - from[1];
+    if !safe(to) || !(-1..=1).contains(&dy) {
+        return None;
+    }
+    if dy > 0 && cell([from[0], from[1] + 2, from[2]]) != Cell::Empty {
+        return None;
+    }
+    let mut breaks = Vec::new();
+    // A descending step also needs the top of the entry column clear.
+    let high = if dy < 0 { from[1] + 1 } else { to[1] + 1 };
+    for y in (to[1]..=high).rev() {
+        let pos = [to[0], y, to[2]];
+        match cell(pos) {
+            Cell::Empty => {}
+            Cell::Solid { breakable: true } if safe(pos) => breaks.push(pos),
+            _ => return None,
+        }
+    }
+    let below = [to[0], to[1] - 1, to[2]];
+    let mut places = Vec::new();
+    match cell(below) {
+        Cell::Solid { .. } => {}
+        Cell::Empty if can_place && dy >= 0 && safe(below) => {
+            if dy > 0 {
+                let lower = [to[0], to[1] - 2, to[2]];
+                match cell(lower) {
+                    Cell::Solid { .. } => {}
+                    Cell::Empty if safe(lower) => places.push(lower),
+                    _ => return None,
+                }
+            }
+            places.push(below);
+        }
+        _ => return None,
+    }
+    let cost = 10 + u32::from(dy != 0) * 7 + 45 * breaks.len() as u32 + 55 * places.len() as u32;
+    let first = breaks
+        .first()
+        .copied()
+        .map(Step::Break)
+        .or_else(|| places.first().copied().map(|p| Step::Place(p, dy > 0)))
+        .unwrap_or(Step::Walk(to));
+    Some((first, cost))
+}
+
+/// A* with a hard expansion cap, never a blind movement fallback. The game
+/// validates each action and replans immediately after it has been confirmed.
+pub(super) fn plan<F, S>(
+    from: Node,
+    goal: [f64; 3],
+    can_place: bool,
+    cell: F,
+    safe: S,
+) -> Option<Step>
+where
+    F: Fn(Node) -> Cell,
+    S: Fn(Node) -> bool,
+{
+    if !safe(from) {
+        return None;
+    }
+    let reached = |n: Node| {
+        (f64::from(n[0]) + 0.5 - goal[0]).hypot(f64::from(n[2]) + 0.5 - goal[2]) <= 0.8
+            && (f64::from(n[1]) - goal[1]).abs() <= 0.8
+    };
+    let h = |n: Node| -> u32 {
+        ((f64::from(n[0]) + 0.5 - goal[0]).abs()
+            + (f64::from(n[1]) - goal[1]).abs()
+            + (f64::from(n[2]) + 0.5 - goal[2]).abs())
+        .max(0.0)
+        .min(10_000.0) as u32
+            * 10
+    };
+    let mut open = BinaryHeap::new();
+    let mut cost = HashMap::new();
+    let mut came: HashMap<Node, (Node, Step)> = HashMap::new();
+    cost.insert(from, 0u32);
+    open.push(Reverse((h(from), from)));
+    let mut expanded = 0;
+    while let Some(Reverse((_, n))) = open.pop() {
+        if n != from && reached(n) {
+            let mut at = n;
+            while let Some(&(previous, action)) = came.get(&at) {
+                if previous == from {
+                    return Some(action);
+                }
+                at = previous;
+            }
+            return None;
+        }
+        expanded += 1;
+        if expanded > 8_000 {
+            return None;
+        }
+        let base = cost[&n];
+        for [dx, dz] in [[1, 0], [-1, 0], [0, 1], [0, -1]] {
+            for dy in [0, 1, -1] {
+                let to = [n[0] + dx, n[1] + dy, n[2] + dz];
+                // Bounded local problem; the outer navigator supplies segments.
+                if (to[0] - from[0]).abs() > 32
+                    || (to[2] - from[2]).abs() > 32
+                    || (to[1] - from[1]).abs() > 12
+                {
+                    continue;
+                }
+                let Some((action, step_cost)) = transition(n, to, can_place, &cell, &safe) else {
+                    continue;
+                };
+                let next = base.saturating_add(step_cost);
+                if cost.get(&to).is_none_or(|old| next < *old) {
+                    cost.insert(to, next);
+                    came.insert(to, (n, action));
+                    open.push(Reverse((next.saturating_add(h(to)), to)));
+                }
+            }
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bridge_is_a_placement_and_never_a_blind_walk() {
+        let cell = |p: Node| {
+            if p[1] == 0 && p[0] == 0 && p[2] == 0 {
+                Cell::Solid { breakable: false }
+            } else {
+                Cell::Empty
+            }
+        };
+        assert_eq!(
+            plan([0, 1, 0], [2.5, 1.0, 0.5], true, cell, |_| true),
+            Some(Step::Place([1, 0, 0], false))
+        );
+        assert_eq!(
+            plan([0, 1, 0], [2.5, 1.0, 0.5], false, cell, |_| true),
+            None
+        );
+    }
+    #[test]
+    fn rises_using_two_scaffold_blocks_and_rejects_hazards() {
+        let cell = |p: Node| {
+            if p == [0, 0, 0] {
+                Cell::Solid { breakable: false }
+            } else {
+                Cell::Empty
+            }
+        };
+        assert_eq!(
+            plan([0, 1, 0], [1.5, 2.0, 0.5], true, cell, |p| p[2] == 0),
+            Some(Step::Place([1, 0, 0], true))
+        );
+        assert_eq!(
+            plan([0, 1, 0], [1.5, 2.0, 0.5], true, cell, |p| p[0] == 0),
+            None
+        );
+    }
+    #[test]
+    fn repeated_replanning_finishes_bridge_and_staircase() {
+        use std::collections::HashMap;
+        fn simulate(goal: [f64; 3]) {
+            let mut cells = HashMap::from([([0, 0, 0], Cell::Solid { breakable: false })]);
+            let mut from = [0, 1, 0];
+            for _ in 0..20 {
+                if (f64::from(from[0]) + 0.5 - goal[0]).hypot(f64::from(from[2]) + 0.5 - goal[2])
+                    <= 0.8
+                    && (f64::from(from[1]) - goal[1]).abs() <= 0.8
+                {
+                    return;
+                }
+                let action = plan(
+                    from,
+                    goal,
+                    true,
+                    |p| *cells.get(&p).unwrap_or(&Cell::Empty),
+                    |_| true,
+                )
+                .unwrap();
+                match action {
+                    Step::Place(p, _) => {
+                        cells.insert(p, Cell::Solid { breakable: true });
+                    }
+                    Step::Break(p) => {
+                        cells.remove(&p);
+                    }
+                    Step::Walk(p) => {
+                        from = p;
+                    }
+                }
+            }
+            panic!("no progress to {goal:?}; at {from:?}");
+        }
+        simulate([3.5, 1.0, 0.5]);
+        simulate([1.5, 2.0, 0.5]);
+    }
+    #[test]
+    fn descending_digs_adjacent_column_not_own_floor() {
+        let cell = |p: Node| {
+            if p[2] != 0 {
+                return Cell::Blocked;
+            }
+            if p[1] <= 0 {
+                Cell::Solid {
+                    breakable: p[1] == 0 && p[0] > 0,
+                }
+            } else {
+                Cell::Empty
+            }
+        };
+        assert_eq!(
+            plan([0, 1, 0], [1.5, 0.0, 0.5], false, cell, |_| true),
+            Some(Step::Break([1, 0, 0]))
+        );
+    }
+}
