@@ -0,0 +1,2888 @@
+//! Independent Impact-style utilities. This does not load the Java client.
+//! The bundled UI exchanges bounded messages with this module only in memory;
+//! no panel, child process or Agent Control socket is involved.
+use super::{
+    Game, Screen,
+    agent::Handled,
+    impact_native_bridge as bridge,
+    impact_native_math::{self as math, Intercept},
+    impact_native_nav::{self as nav, Cell, Step},
+};
+use horizon_client::text::Text;
+use horizon_client::{
+    chunk::{MIN_Y, SECTIONS},
+    gizmos::{Gizmos, Line},
+};
+use horizon_core::geometry::Vec3;
+use horizon_world::registry::BlockStateId;
+use std::{
+    collections::HashMap,
+    sync::Arc,
+    sync::mpsc::{self, Receiver, TryRecvError},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+use winit::{event::MouseButton, event_loop::ActiveEventLoop, keyboard::KeyCode};
+
+const SCAN_SECONDS: u64 = 4;
+const UPDATE_MILLIS: u64 = 500;
+const MAX_NAV_DISTANCE: f64 = 2048.0;
+const NAV_SEGMENT: f64 = 24.0;
+const MAX_ORE_RESULTS: usize = 128;
+const SCAN_BUDGET_MICROS: u128 = 1200;
+const SCAN_SECTIONS_PER_CALL: usize = 8;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum TaskKind {
+    Walk,
+    Navigate,
+    NavEdit,
+    Mine,
+}
+struct Pending {
+    kind: TaskKind,
+    rx: Receiver<String>,
+}
+
+/// Sneak continuously while moving onto the safe overhang of an existing
+/// full block. No separate process or socket controls this operation.
+struct NavEdge {
+    target: [i32; 3],
+    support: [i32; 3],
+    dx: i32,
+    dz: i32,
+    item: String,
+    rising: bool,
+    started: Instant,
+    settled: Option<Instant>,
+}
+
+/// Only coordinates are kept; chunks can unload between slices of the scan.
+struct OreScan {
+    eye: [f64; 3],
+    dimension: String,
+    radius: i32,
+    sections: Vec<(i32, usize, i32)>,
+    cursor: usize,
+    found: Vec<([i32; 3], f64)>,
+}
+
+struct PlayerView<'a> {
+    mob: &'a horizon_client::mobs::Mob,
+    uuid: u128,
+    name: String,
+}
+struct BridgeBuild {
+    route: Vec<[i32; 3]>,
+    next: usize,
+    waiting: bool,
+}
+/// A slow, owned sneak towards the centre of one solid support block.
+struct BridgeCenter {
+    support: [i32; 3],
+    started: Instant,
+}
+
+struct CritPending {
+    target: u32,
+    manual: bool,
+    started: Instant,
+    initial_yaw: f32,
+    initial_pitch: f32,
+}
+
+pub(super) struct NativeImpact {
+    session: String,
+    mod_generation: Option<u64>,
+    heartbeat: u64,
+    last_bridge_seq: u64,
+    last_native_seq: u64,
+    last_update: Option<Instant>,
+    last_scan: Option<Instant>,
+    last_action: Option<Instant>,
+    ore: bool,
