+fn ore_matches(category: &str, name: &str) -> bool {
+    let id = name.strip_prefix("minecraft:").unwrap_or(name);
+    match category {
+        "diamond" => matches!(id, "diamond_ore" | "deepslate_diamond_ore"),
+        "iron" => matches!(id, "iron_ore" | "deepslate_iron_ore"),
+        "gold" => matches!(id, "gold_ore" | "deepslate_gold_ore" | "nether_gold_ore"),
+        "redstone" => matches!(id, "redstone_ore" | "deepslate_redstone_ore"),
+        "emerald" => matches!(id, "emerald_ore" | "deepslate_emerald_ore"),
+        "coal" => matches!(id, "coal_ore" | "deepslate_coal_ore"),
+        "copper" => matches!(id, "copper_ore" | "deepslate_copper_ore"),
+        "lapis" => matches!(id, "lapis_ore" | "deepslate_lapis_ore"),
+        "quartz" => id == "nether_quartz_ore",
+        "debris" => id == "ancient_debris",
+        _ => false,
+    }
+}
+fn number(text: &str, min: f64, max: f64) -> Option<f64> {
+    let n: f64 = text.parse().ok()?;
+    (n.is_finite() && (min..=max).contains(&n)).then_some(n)
+}
+fn xray_rules(text: &str) -> Option<Vec<(String, bool)>> {
+    if text.is_empty() {
+        return Some(Vec::new());
+    }
+    let mut result = Vec::new();
+    for rule in text.split(',') {
+        let (name, value) = rule.split_once('=')?;
+        if name.is_empty()
+            || name.len() > 48
+            || !name.contains(':')
+            || !name
+                .bytes()
+                .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || b"_.:/-".contains(&c))
+            || result.len() >= 16
+            || result.iter().any(|(n, _)| n == name)
+        {
+            return None;
+        }
+        result.push((name.to_owned(), switch(value)?));
+    }
+    result.sort_by(|a, b| a.0.cmp(&b.0));
+    Some(result)
+}
+fn switch(text: &str) -> Option<bool> {
+    match text {
+        "on" | "1" => Some(true),
+        "off" | "0" => Some(false),
+        _ => None,
+    }
+}
+impl Game<'_> {
+    fn impact_current_hit(&self) -> Option<(u32, f64)> {
+        let mob = self
+            .mob_hit()
+            .and_then(|(i, d)| self.before_block(d).then_some((self.mobs[i].id, d)));
+        let guest = self.guest_hit().and_then(|(conn, d)| {
+            let m = self.lan.as_ref()?.models.get(&conn)?;
+            self.before_block(d).then_some((m.id, d))
+        });
+        match (mob, guest) {
+            (Some(a), Some(b)) => Some(if a.1 <= b.1 { a } else { b }),
+            (Some(a), None) | (None, Some(a)) => Some(a),
+            _ => None,
+        }
+    }
+    fn impact_center(&self, id: u32) -> Option<[f64; 3]> {
+        self.mobs
+            .iter()
+            .find(|m| m.id == id && m.alive())
+            .map(|m| m.center())
+            .or_else(|| {
+                self.lan
+                    .as_ref()?
+                    .models
+                    .values()
+                    .find(|m| m.id == id && m.alive())
+                    .map(|m| m.center())
+            })
+    }
+    pub(super) fn impact_protect_attack(&self) -> bool {
+        self.impact_native
+            .as_ref()
+            .is_some_and(|n| n.friends_selecting || n.friend_risk(self))
+    }
+    pub(super) fn impact_native_mouse(&mut self, button: MouseButton, pressed: bool) -> bool {
+        let Some(mut n) = self.impact_native.take() else {
+            return false;
+        };
+        let consumed = n.mouse(self, button, pressed);
+        self.impact_native = Some(n);
+        consumed
+    }
+    pub(super) fn impact_native_frame(&mut self, event_loop: &ActiveEventLoop) {
+        if let Some(mut native) = self.impact_native.take() {
+            native.frame(self, event_loop);
+            self.impact_native = Some(native);
+        }
+    }
+}
+impl NativeImpact {
+    fn say(game: &mut Game<'_>, text: impl AsRef<str>) {
+        game.system_message(Text::literal(format!("[Impact Native] {}", text.as_ref())));
+    }
+    fn reset_active(&mut self) {
+        self.attack = false;
+        self.walk = false;
+        self.aim = false;
+        self.bow = false;
+        self.mine = false;
+        self.player_attack = false;
+        self.player_bow = false;
+        self.friends_selecting = false;
+        self.bridge_selecting = false;
+        self.bridge_first = None;
+        self.bridge_build = None;
+        self.bridge_centering = None;
+        self.queued_nav = None;
+        self.nav_started = false;
+        self.nav_edge = None;
+        self.nav_retreat = None;
+        self.nav_airborne_since = None;
+        self.last_lead = None;
+    }
+    fn drain_pending(&mut self, game: &mut Game<'_>) {
+        let result = self.pending.as_ref().map(|p| (p.kind, p.rx.try_recv()));
+        match result {
+            Some((kind, Ok(line))) => {
+                self.pending = None;
+                let error = serde_json::from_str::<serde_json::Value>(&line)
+                    .ok()
+                    .and_then(|v| v["error"].as_str().map(str::to_owned));
+                if matches!(kind, TaskKind::Navigate) {
+                    if let Some(e) = &error {
+                        self.queued_nav = None;
+                        self.nav_started = false;
+                        self.bridge_build = None;
+                        Self::say(game, format!("Navigation stopped: {e}"));
+                    } else if self
+                        .queued_nav
+                        .is_some_and(|goal| Self::arrived(game, goal))
+                    {
+                        self.queued_nav = None;
+                        self.nav_started = false;
+                        Self::say(game, "Navigation finished.");
+                    }
+                    // Otherwise retain the far goal; the next frame starts
+                    // another short path through the newly loaded chunks.
+                }
+                if matches!(kind, TaskKind::NavEdit)
+                    && let Some(error) = &error
+                {
+                    self.queued_nav = None;
+                    self.nav_started = false;
+                    self.nav_retreat = None;
+                    self.bridge_build = None;
+                    Self::say(game, format!("Navigation edit stopped: {error}"));
+                }
+                if matches!(kind, TaskKind::Mine) {
+                    // The last scan still named the block we just broke. Never
+                    // try to mine that stale position a second time: rescan
+                    // immediately before selecting the next target.
+                    self.invalidate_scan();
+                    if let Some(error) = error {
+                        self.mine = false;
+                        Self::say(game, format!("AutoMine stopped: {error}"));
+                    }
+                }
+            }
+            Some((kind, Err(TryRecvError::Disconnected))) => {
+                self.pending = None;
+                if kind == TaskKind::Navigate {
+                    self.queued_nav = None;
+                    self.nav_started = false;
+                    self.bridge_build = None;
+                    Self::say(game, "Navigation stopped: action channel closed.");
+                }
+                if kind == TaskKind::NavEdit {
+                    self.queued_nav = None;
+                    self.nav_started = false;
+                    self.bridge_build = None;
+                    self.nav_retreat = None;
+                    Self::say(game, "Navigation stopped: edit channel closed.");
+                }
+                if kind == TaskKind::Mine {
+                    self.mine = false;
+                    self.invalidate_scan();
+                }
+            }
+            _ => {}
+        }
+    }
+    fn cancel_own(&mut self, game: &mut Game<'_>, event_loop: &ActiveEventLoop) {
+        self.drain_pending(game);
+        // Do not stop a task owned by an external controller or release a
+        // player's real keys when this module has no outstanding task.
+        let had_edge = self.nav_edge.take().is_some();
+        if self.bridge_centering.take().is_some() {
+            for key in [KeyCode::KeyW, KeyCode::ShiftLeft] {
+                if !game.physical_keys.contains(&key) {
+                    game.keys.remove(&key);
+                }
+            }
+        }
+        self.nav_retreat = None;
+        self.nav_airborne_since = None;
+        self.cancel_critical(game);
+        if self.pending.take().is_some() || had_edge {
+            let (tx, _) = mpsc::channel();
+            let _ = game.agent_command(&["stop"], "stop", &tx, event_loop);
+        }
+    }
+    fn disable_active(&mut self, game: &mut Game<'_>, event_loop: &ActiveEventLoop) {
+        self.cancel_own(game, event_loop);
+        self.reset_active();
+    }
+    fn do_action(
+        &mut self,
+        game: &mut Game<'_>,
+        event_loop: &ActiveEventLoop,
+        line: String,
+        kind: TaskKind,
+    ) -> Result<(), String> {
+        if self.pending.is_some() {
+            return Err("another native action is running".into());
+        }
+        let words: Vec<_> = line.split_whitespace().collect();
+        let (tx, rx) = mpsc::channel();
+        match game
+            .agent_command(&words, &line, &tx, event_loop)
+            .map_err(|e| e.to_string())?
+        {
+            Handled::Deferred => {
+                self.pending = Some(Pending { kind, rx });
+                Ok(())
+            }
+            Handled::Reply(_) => Ok(()),
+            Handled::No => Err("internal action not available".into()),
+        }
+    }
+    fn bridge_request(&mut self, game: &mut Game<'_>, event_loop: &ActiveEventLoop) {
+        let Some(raw) = game.mods.mods.impact_native_request("bridge_request") else {
+            return;
+        };
+        let Ok(line) = std::str::from_utf8(&raw) else {
+            return;
+        };
+        let a: Vec<_> = line.trim().split('|').collect();
+        if a.len() != 5 || a[0] != "v1" || a[1] != self.session {
+            return;
+        }
+        let Ok(seq) = a[2].parse::<u64>() else { return };
+        if seq <= self.last_bridge_seq {
+            return;
+        }
+        let Some(on) = switch(a[4]) else { return };
+        self.last_bridge_seq = seq;
+        match a[3] {
+            "stop" => {
+                self.disable_active(game, event_loop);
+                self.ore = false;
+                self.radar = false;
+            }
+            "ore" => {
+                self.ore = on;
+                if !on {
+                    self.mine = false;
+                }
+                self.invalidate_scan();
+            }
+            "radar" => self.radar = on,
+            "attack" => {
+                self.disable_active(game, event_loop);
+                self.attack = on;
+            }
+            "walk" => {
+                self.disable_active(game, event_loop);
+                self.walk = on;
+            }
+            _ => {}
+        }
+        self.last_update = None;
+    }
+    fn native_request(&mut self, game: &mut Game<'_>, event_loop: &ActiveEventLoop) {
+        let Some(raw) = game.mods.mods.impact_native_request("native_request") else {
+            return;
+        };
+        let Ok(line) = std::str::from_utf8(&raw) else {
+            return;
+        };
+        let a: Vec<_> = line.trim().split('|').collect();
+        if a.len() < 4 || a.len() > 7 || a[0] != "v1" || a[1] != self.session {
+            return;
+        }
+        let Ok(seq) = a[2].parse::<u64>() else { return };
+        if seq <= self.last_native_seq {
+            return;
+        }
+        self.last_native_seq = seq;
+        match a.as_slice() {
+            [_, _, _, "goto", x, y, z] => {
+                let target = number(x, -30_000_000.0, 30_000_000.0)
+                    .zip(number(y, -64.0, 320.0))
+                    .zip(number(z, -30_000_000.0, 30_000_000.0))
+                    .map(|((x, y), z)| [x, y, z]);
+                let valid = target.zip(game.player.as_ref()).is_some_and(|(t, p)| {
+                    let dx = t[0] - p.position.x;
+                    let dy = t[1] - p.position.y;
+                    let dz = t[2] - p.position.z;
+                    (dx * dx + dy * dy + dz * dz).sqrt() <= MAX_NAV_DISTANCE
+                });
+                if valid {
+                    self.disable_active(game, event_loop);
+                    self.queued_nav = target;
+                    Self::say(
+                        game,
+                        "Navigation queued; close the chat/menu. STOP cancels it.",
+                    );
+                } else {
+                    Self::say(game, "Invalid target or more than 2048 blocks away.");
+                }
+            }
+            [_, _, _, "range", value] => {
+                if let Some(x) = number(value, 1.0, 6.0) {
