+                    Self::say(game, format!("Attack interval: {x:.1} seconds."));
+                } else {
+                    Self::say(game, "Attack interval must be 0.1 to 5 seconds.");
+                }
+            }
+            [_, _, _, "aimradius", value] => {
+                if let Some(x) = number(value, 4.0, 128.0) {
+                    self.aim_radius = x;
+                    Self::say(
+                        game,
+                        format!("Aim search radius: {x:.0} blocks (loaded mobs only)."),
+                    );
+                } else {
+                    Self::say(game, "Aim radius must be 4 to 128.");
+                }
+            }
+            [_, _, _, "targets", value] => match *value {
+                "hostile" => {
+                    self.all_mobs = false;
+                    Self::say(game, "Targeting hostile mobs only.");
