+                    self.invalidate_scan();
+                    Self::say(game, format!("Ore type: {value}."));
+                } else {
+                    Self::say(
+                        game,
+                        "Unknown ore type. Try diamond, iron, gold, redstone, emerald, coal, copper, lapis, quartz, debris.",
+                    );
+                }
+            }
+            [_, _, _, "oreradius", value] => {
+                if let Some(n) = number(value, 4.0, 128.0).filter(|n| n.fract() == 0.0) {
+                    self.ore_radius = n as i32;
+                    self.invalidate_scan();
+                    Self::say(game, format!("Ore scan radius: {n} blocks."));
+                } else {
+                    Self::say(game, "Ore radius must be an integer from 4 to 128.");
+                }
+            }
+            [_, _, _, "friends", "select"] => {
+                self.disable_active(game, event_loop);
+                game.impact_clear_queued_attack();
+                self.friends_selecting = true;
+                Self::say(
+                    game,
+                    "Свои: наведитесь на игрока и нажмите ЛКМ. Удар не наносится.",
+                );
+            }
+            [_, _, _, "friends", "list"] => {
+                let mut names: Vec<_> = self
+                    .friends
+                    .values()
+                    .map(|name| {
+                        name.chars()
+                            .filter(|c| !c.is_control())
+                            .take(32)
+                            .collect::<String>()
+                    })
+                    .collect();
+                names.sort_unstable();
+                let total = names.len();
+                if total == 0 {
+                    Self::say(game, "Список своих пуст.");
+                } else {
+                    names.truncate(16);
+                    let extra = if total > names.len() {
+                        format!(" (и ещё {})", total - names.len())
+                    } else {
